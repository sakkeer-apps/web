# ==============================================================================
# Muhammed Sakkeer Portfolio & Software Download Portal - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, API keys, or service role credentials to git.

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Mandatory for production database & durable storage)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon / Public Key (Safe for client-side usage, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose to client!)
# Used by administrative scripts (e.g. provision-owner) and protected backend endpoints
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Application & Canonical Domain Settings
# ------------------------------------------------------------------------------
# The primary canonical URL for the website (used for SEO, metadata, sitemaps, auth redirects)
# In development: http://localhost:3000
# In production: https://muhammedsakkeer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional secondary alias domain (e.g. sakkeer.ai or www.muhammedsakkeer.com)
SECONDARY_DOMAIN=

# ------------------------------------------------------------------------------
# 3. Owner Account Provisioning
# ------------------------------------------------------------------------------
# Used exclusively by `pnpm run seed:admin` to create the initial owner account securely.
# If unset, the CLI script will interactively prompt for these values.
OWNER_EMAIL=techsakeer@gmail.com
OWNER_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Optional Notification Service (Email Notifications for Contact Form)
# ------------------------------------------------------------------------------
# If configured, new contact inquiries will dispatch an email alert to the owner.
# Submissions are ALWAYS saved to the admin inbox in PostgreSQL regardless of email delivery.
RESEND_API_KEY=
NOTIFICATION_RECIPIENT_EMAIL=techsakeer@gmail.com
NOTIFICATION_FROM_EMAIL=notifications@muhammedsakkeer.com

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting
# ------------------------------------------------------------------------------
# Salt used for hashing IP addresses for honest download deduplication and spam throttling.
# If not provided, a default internal salt will be derived.
RATE_LIMIT_SALT=replace-with-a-random-secret-string-in-production
